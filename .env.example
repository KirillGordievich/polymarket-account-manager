# ─── Polymarket Account Manager ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Usage: cp .env.example .env

# ─── 🟢 User-configurable settings ──────────────────────────────────────────────
# These values are safe to change.

# Polygon RPC endpoint (default: public RPC, consider using Alchemy/Infura for reliability)
RPC_URL=https://polygon-bor-rpc.publicnode.com

# Default referral code supports the developer of this tool.
# To disable it, uncomment the line below and leave it empty:
# REFERRAL=SupportMeCode

# ───⚠️ Internal system settings ────────────────────────────────────────────────
# Polygon/Polymarket addresses and endpoints.
# DO NOT CHANGE these values unless you know exactly what you're doing

# Polygon chain ID (137 = mainnet, don't change unless testing)
CHAIN_ID=137

# Contract addresses
USDC_E_POLYGON=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
CTF_EXCHANGE=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E
NEG_RISK_CTF_EXCHANGE=0xC5d563A36AE78145C45a50134d48A1215220f80a
NEG_RISK_ADAPTER=0xd91E80cF2E7be2e162c6513ceD06f1dD0dA35296

# API endpoints
POLYMARKET_URL=https://polymarket.com
GAMMA_API=https://gamma-api.polymarket.com
CLOB_HOST=https://clob.polymarket.com
RELAYER_URL=https://relayer-v2.polymarket.com/submit
FUN_XYZ_API=https://api.fun.xyz/v1/eoa
FUN_XYZ_KEY=Y53dikxXdT4E3afI1l8BMBSWgyhKvf65k6Dut1k6